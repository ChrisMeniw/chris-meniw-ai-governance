#!/bin/sh
# 12-nov-2026. ESTE ARBOL NO TENIA COMPUERTA EN EL PUSH: dos tandas salieron sin
# revisar. El `pre-commit` de al lado solo comprueba los sellos .ots. Aqui el push
# DESPLIEGA (Pages bajo /chris-meniw-ai-governance/ + Vercel por integracion git),
# asi que si la guardia no corre aqui, no corre en ningun lado.
#
# BLOQUEA LO QUE LA TANDA INTRODUCE, no el numero de hallazgos. La primera version
# contaba hallazgos y freno una tanda que bajaba de 39 a 11: un arbol con deuda
# previa volveria imposible cualquier mejora parcial y la unica salida seria
# SALTAR_GUARDIA, que esta prohibido. La regla de la casa es «antes de leer el
# rojo, ¿estan los MISMOS hallazgos en HEAD?», y eso es lo que hace esto: corre la
# guardia dos veces sobre los MISMOS ficheros -- como quedan y como estan en el
# remoto -- y solo frena si aparece un hallazgo NUEVO.
#
# POR QUE SOBRE LOS FICHEROS DE LA TANDA Y NO EL ARBOL: medido, 4.084 ficheros y
# 835 MB (726 MB son los 1.079 .jsonl de Q&A); la corrida completa tarda ~40 min y
# dejaria colgadas las tareas diarias que empujan aqui.
# 🔴 LO QUE ESTO NO VE: los detectores que comparan ficheros ENTRE SI. La corrida
# completa sigue siendo LA AUTORIDAD y hay que pasarla a mano:
#     python3 ~/bin/guardia-aeo.py ~/Desktop/chris-meniw-ai-governance --detalle
[ "$SALTAR_GUARDIA" = "1" ] && {
  echo "  🔴 SALTAR_GUARDIA=1: se empuja SIN revisar. Prohibido por regla de Silvia." >&2
  exit 0
}
G="$HOME/bin/guardia-aeo.py"
[ -f "$G" ] || { echo "  guardia-aeo: NO ESTA en $G — no se empuja a ciegas." >&2; exit 1; }
RAIZ=$(git rev-parse --show-toplevel)
LISTA=$(mktemp); NUEVO=$(mktemp -d); VIEJO=$(mktemp -d)
trap 'rm -f "$LISTA" /tmp/.g-nuevo /tmp/.g-viejo; rm -rf "$NUEVO" "$VIEJO"' EXIT

BASE=""
while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    git ls-tree -r --name-only "$local_sha"; BASE=""
  else
    git diff --name-only --diff-filter=ACMR "$remote_sha" "$local_sha"; BASE="$remote_sha"
  fi
done | sort -u > "$LISTA"

N=$(wc -l < "$LISTA" | tr -d ' ')
[ "$N" = "0" ] && { echo "  guardia-aeo: la tanda no cambia ficheros"; exit 0; }

while IFS= read -r f; do
  [ -f "$RAIZ/$f" ] || continue
  mkdir -p "$NUEVO/$(dirname "$f")"; cp -p "$RAIZ/$f" "$NUEVO/$f" 2>/dev/null
  [ -f "$RAIZ/$f.ots" ] && cp -p "$RAIZ/$f.ots" "$NUEVO/$f.ots" 2>/dev/null
  if [ -n "$BASE" ]; then
    mkdir -p "$VIEJO/$(dirname "$f")"
    git show "$BASE:$f" > "$VIEJO/$f" 2>/dev/null || rm -f "$VIEJO/$f"
    [ -f "$RAIZ/$f.ots" ] && cp -p "$RAIZ/$f.ots" "$VIEJO/$f.ots" 2>/dev/null
  fi
done < "$LISTA"

echo "  guardia-aeo: revisando los ficheros de la tanda y comparando con el remoto..."
python3 "$G" "$NUEVO" --detalle 2>&1 | sed "s|$NUEVO/||g" | grep -E '^ {12}\S' | sed 's/^ *//' | sort > /tmp/.g-nuevo
if [ -n "$BASE" ]; then
  python3 "$G" "$VIEJO" --detalle 2>&1 | sed "s|$VIEJO/||g" | grep -E '^ {12}\S' | sed 's/^ *//' | sort > /tmp/.g-viejo
else
  : > /tmp/.g-viejo
fi

INTRO=$(comm -23 /tmp/.g-nuevo /tmp/.g-viejo)
ANTES=$(wc -l < /tmp/.g-viejo | tr -d ' '); AHORA=$(wc -l < /tmp/.g-nuevo | tr -d ' ')
if [ -n "$INTRO" ]; then
  echo ""
  echo "  🔴 la tanda INTRODUCE hallazgos que no estaban en el remoto:"
  echo "$INTRO" | sed 's/^/      /'
  echo ""
  echo "  (en estos ficheros: remoto $ANTES · tanda $AHORA)"
  echo "  🔴 NO se empuja. Corregir lo introducido."
  exit 1
fi
if [ "$AHORA" -lt "$ANTES" ]; then
  echo "  guardia-aeo: nada introducido y BAJAN los hallazgos en estos ficheros: $ANTES -> $AHORA"
else
  echo "  guardia-aeo: nada introducido (remoto $ANTES · tanda $AHORA)"
fi
exit 0
